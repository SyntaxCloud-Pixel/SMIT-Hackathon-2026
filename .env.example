# HCM Lite — Environment Configuration Template
# Saylani Hackathon Project 2026

# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Supabase PostgreSQL Connection)
# Direct connection string or Supabase Transaction Pooler connection string:
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Identity & Storage (Server only)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d

# AI Assistant Integration (Server only)
# Supports Gemini or OpenAI. If omitted, the deterministic enterprise grounded tool engine operates automatically.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ==============================================================================
# FRONTEND CONFIGURATION (VITE)
# (Never place database credentials or service-role keys here)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:5000/api
